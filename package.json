{
  "name": "ai-dongwo",
  "version": "1.0.0",
  "description": "AI懂我 - 心智障碍者动态支持档案",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "AI懂我",
  "license": "MIT",
  "build": {
    "appId": "com.ai-dongwo.app",
    "productName": "AI懂我",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "js/**/*",
      "css/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "private": true
}
